[Unit]
Description=PhotoKiosk FastAPI Backend & Administration Service
After=network.target

[Service]
Type=simple
User=kiosk
Group=kiosk
WorkingDirectory=/opt/photokiosk
Environment="PYTHONPATH=/opt/photokiosk"
ExecStart=/opt/photokiosk/venv/bin/python3 main.py --mode backend --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
