# PhotoKiosk Samba Configuration Template
# Place in /etc/samba/smb.conf or include as an extra configuration file

[global]
   workgroup = WORKGROUP
   server string = Photo Kiosk File Server
   server role = standalone server
   security = user
   map to guest = Never
   passdb backend = tdbsam
   obey pam restrictions = yes
   unix password sync = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d

   # Performance & Network optimizations
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   min receivefile size = 16384
   use sendfile = yes
   aio read size = 16384
   aio write size = 16384

   # Security: prevent public internet exposure
   hosts allow = 127. 192.168. 10. 172.16. 172.17. 172.18. 172.19. 172.20. 172.21. 172.22. 172.23. 172.24. 172.25. 172.26. 172.27. 172.28. 172.29. 172.30. 172.31.
   hosts deny = ALL

# Main Shared Photo Ingestion Directory
[Photos]
   comment = Photo Kiosk Shared Drop Folder
   path = /opt/photokiosk/storage/shared
   browseable = yes
   read only = no
   guest ok = no
   valid users = kioskadmin, kioskuser
   create mask = 0664
   directory mask = 0775
   force create mode = 0664
   force directory mode = 0775
